<Application x:Class="WpfHarness.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:WpfHarness.Converters"
             Exit="OnExit"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/MdStyle.xaml" />
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
                <!-- 共享控件样式（Keycap / Badge / GhostButton / FieldTextBox / SuggestionCard …） -->
                <ResourceDictionary Source="pack://application:,,,/Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 共享转换器 -->
            <c:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <c:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />
            <c:InverseBoolConverter x:Key="InverseBoolConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <c:RelativeTimeConverter x:Key="RelativeTime" />
            <c:EmptyToVisibilityConverter x:Key="EmptyToVis" />

            <!-- ===== 色板：三级表面 + 三级文字 + 橙色体系 ===== -->
            <Color x:Key="WindowBgColor">#101014</Color>
            <Color x:Key="SidebarColor">#15151A</Color>
            <Color x:Key="SurfaceColor">#1B1B21</Color>
            <Color x:Key="ElevatedColor">#222229</Color>
            <Color x:Key="BorderColor">#2C2C34</Color>
            <Color x:Key="HoverColor">#28282F</Color>

            <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
            <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource HoverColor}" />

            <!-- 语义化补充 token：消除页面里的硬编码颜色 -->
            <SolidColorBrush x:Key="UserBubbleBrush" Color="#26262E" />
            <SolidColorBrush x:Key="UserBubbleBorderBrush" Color="#30303A" />
            <SolidColorBrush x:Key="TextOnAccentBrush" Color="#FFFFFF" />
            <!-- 叠在主色块上的半透明白（快捷键标签底色/描边） -->
            <SolidColorBrush x:Key="AccentOverlayBrush" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="AccentOverlayBorderBrush" Color="#55FFFFFF" />
            <SolidColorBrush x:Key="AccentOverlayTextBrush" Color="#FFEBD9" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDF0" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A4A4AE" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#92929C" />

            <SolidColorBrush x:Key="AccentBrush" Color="#F97316" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FB8C3C" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#2A1B10" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#4A2E14" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E5534B" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#2A1717" />

            <!-- 覆盖 WPF-UI 控件强调色：统一为橙色体系（对话框主按钮 / RadioButton / 选择态） -->
            <Color x:Key="SystemAccentColor">#F97316</Color>
            <Color x:Key="SystemAccentColorPrimary">#F97316</Color>
            <Color x:Key="SystemAccentColorSecondary">#FB8C3C</Color>
            <Color x:Key="SystemAccentColorTertiary">#C26430</Color>
            <SolidColorBrush x:Key="SystemAccentColorBrush" Color="#F97316" />
            <SolidColorBrush x:Key="SystemAccentColorPrimaryBrush" Color="#F97316" />
            <SolidColorBrush x:Key="SystemAccentColorSecondaryBrush" Color="#FB8C3C" />
            <SolidColorBrush x:Key="SystemAccentColorTertiaryBrush" Color="#C26430" />
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#F97316" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FB8C3C" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#C26430" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FB8C3C" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />

            <!-- 全局字体 -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>
            <Style TargetType="{x:Type UserControl}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
            </Style>

            <!-- Keycap / Badge / GhostButton 等控件样式已迁移至 Resources/Styles.xaml -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
