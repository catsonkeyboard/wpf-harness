<Application x:Class="WpfHarness.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:c="clr-namespace:WpfHarness.Converters"
             Exit="OnExit"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/MdStyle.xaml" />
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!-- 共享转换器 -->
            <c:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <c:NonEmptyToVisibilityConverter x:Key="NonEmptyToVis" />
            <c:InverseBoolConverter x:Key="InverseBoolConverter" />
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <c:RelativeTimeConverter x:Key="RelativeTime" />

            <!-- ===== 色板：三级表面 + 三级文字 + 橙色体系 ===== -->
            <Color x:Key="WindowBgColor">#101014</Color>
            <Color x:Key="SidebarColor">#15151A</Color>
            <Color x:Key="SurfaceColor">#1B1B21</Color>
            <Color x:Key="ElevatedColor">#222229</Color>
            <Color x:Key="BorderColor">#2C2C34</Color>
            <Color x:Key="HoverColor">#28282F</Color>

            <SolidColorBrush x:Key="WindowBgBrush" Color="{StaticResource WindowBgColor}" />
            <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="ElevatedBrush" Color="{StaticResource ElevatedColor}" />
            <SolidColorBrush x:Key="CardBrush" Color="{StaticResource SurfaceColor}" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource BorderColor}" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource HoverColor}" />

            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EDEDF0" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A4A4AE" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#6A6A74" />

            <SolidColorBrush x:Key="AccentBrush" Color="#F97316" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#FB8C3C" />
            <SolidColorBrush x:Key="AccentSubtleBrush" Color="#2A1B10" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#4A2E14" />
            <SolidColorBrush x:Key="DangerBrush" Color="#E5534B" />
            <SolidColorBrush x:Key="DangerSubtleBrush" Color="#2A1717" />

            <!-- 全局字体 -->
            <Style TargetType="{x:Type Window}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
            </Style>
            <Style TargetType="{x:Type UserControl}">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
            </Style>

            <!-- keycap 快捷键徽标 -->
            <Style x:Key="Keycap" TargetType="Border">
                <Setter Property="Background" Value="#22222A" />
                <Setter Property="BorderBrush" Value="#33333C" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="5,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 小徽章 -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="Background" Value="#22222A" />
                <Setter Property="CornerRadius" Value="5" />
                <Setter Property="Padding" Value="6,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- ghost 图标按钮 -->
            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="{TemplateBinding Tag}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
