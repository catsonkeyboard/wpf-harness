<UserControl x:Class="WpfHarness.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel Margin="8,4,8,0" Width="560">
            <TextBlock Text="配置模型服务（OpenAI 兼容接口或离线 Mock）。API Key 使用机器绑定加密存储。"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <ItemsControl ItemsSource="{Binding Providers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="14" FontWeight="SemiBold" BorderThickness="0"
                                             Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <Button Grid.Column="1" Content="✕ 删除" FontSize="11" Cursor="Hand"
                                            Command="{Binding DataContext.RemoveProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Foreground="{DynamicResource DangerBrush}" Background="Transparent" BorderThickness="0" />
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="类型" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <ComboBox Grid.Column="1" SelectedValue="{Binding Type}" SelectedValuePath="Content" VerticalAlignment="Center">
                                        <ComboBoxItem Content="openai-compat" />
                                        <ComboBoxItem Content="mock" />
                                    </ComboBox>
                                    <RadioButton Grid.Column="2" Content="设为默认" VerticalAlignment="Center"
                                                 GroupName="DefaultProvider" FontSize="12" Margin="8,0,0,0"
                                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                                 IsChecked="{Binding IsDefault, Mode=TwoWay}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BaseUrl" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Padding="4" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="模型" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Padding="4" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="API Key" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Padding="4" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="代理" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBox Grid.Column="1" Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}"
                                             FontSize="12" Padding="4"
                                             ToolTip="可选，http://host:port" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Content="＋ 添加模型服务" Padding="10,6" HorizontalAlignment="Left" Cursor="Hand"
                    Command="{Binding AddProviderCommand}"
                    Background="Transparent" BorderBrush="{DynamicResource AccentBrush}"
                    Foreground="{DynamicResource AccentBrush}" Margin="0,2,0,8" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
