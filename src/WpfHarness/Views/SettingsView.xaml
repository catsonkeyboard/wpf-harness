<UserControl x:Class="WpfHarness.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WpfHarness.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="640" d:DesignHeight="560"
             Background="Transparent">
    <!-- 表单样式统一复用 Resources/Styles.xaml -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
        <StackPanel Margin="8,4,8,0" Width="560">
            <TextBlock Text="配置模型服务（OpenAI 兼容接口或离线 Mock）。API Key 使用机器绑定加密存储。"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <!-- 空状态：还没有任何 Provider 时给个引导 -->
            <Border Visibility="{Binding Providers.Count, Converter={StaticResource EmptyToVis}}"
                    Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24,20" Margin="0,0,0,12">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="还没有配置模型服务" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <TextBlock Text="点下方「＋ 添加模型服务」接入第一个模型" FontSize="11.5"
                               HorizontalAlignment="Center" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Providers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="ProviderCard" Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <!-- 卡片头：名称 + 删除 -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource CardTitleTextBox}"
                                             Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="服务显示名" />
                                    <Button Grid.Column="1" Style="{StaticResource DangerGhostButton}" Content="✕ 删除"
                                            Command="{Binding DataContext.RemoveProviderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>

                                <!-- 类型 + 设为默认 -->
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="类型" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1" Style="{StaticResource FieldComboBox}"
                                              SelectedValue="{Binding Type}" SelectedValuePath="Content">
                                        <ComboBoxItem Content="openai-compat" />
                                        <ComboBoxItem Content="mock" />
                                    </ComboBox>
                                    <RadioButton Grid.Column="2" VerticalAlignment="Center" GroupName="DefaultProvider"
                                                 Margin="12,0,0,0" IsChecked="{Binding IsDefault, Mode=TwoWay}">
                                        <RadioButton.Template>
                                            <ControlTemplate TargetType="RadioButton">
                                                <StackPanel Orientation="Horizontal" Background="Transparent">
                                                    <Border x:Name="Ring" Width="16" Height="16" CornerRadius="8"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource CardBorderBrush}"
                                                            BorderThickness="1.5" />
                                                    <TextBlock Text="设为默认" FontSize="12" Margin="7,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Ring" Property="BorderBrush"
                                                                Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="Ring" Property="Background"
                                                                Value="{DynamicResource AccentBrush}" />
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Ring" Property="BorderBrush"
                                                                Value="{DynamicResource TextTertiaryBrush}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </RadioButton.Template>
                                    </RadioButton>
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="BaseUrl" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                             Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="模型" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                             Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="API Key" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                             Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="代理" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Style="{StaticResource FieldTextBox}"
                                             Text="{Binding Proxy, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="可选，http://host:port" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button Style="{StaticResource OutlineAccentButton}" Command="{Binding AddProviderCommand}"
                    HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                    Padding="12,6" Margin="0,2,0,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="＋" FontSize="12" FontWeight="Bold" />
                    <TextBlock Text="添加模型服务" FontSize="12" Margin="6,0,0,0" />
                </StackPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
