<UserControl x:Class="WpfHarness.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:WpfHarness.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}"
             d:DesignWidth="920" d:DesignHeight="752"
             Background="{DynamicResource WindowBgBrush}">
    <!-- 样式全部来自 Resources/Styles.xaml（共享字典），本页不重复定义 -->

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,24">
            <StackPanel Width="640" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- 品牌 + 问候 -->
                <StackPanel Margin="0,0,0,24">
                    <Border Width="44" Height="44" CornerRadius="12" HorizontalAlignment="Center"
                            Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1">
                        <TextBlock Text="⚡" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="{Binding Greeting}" FontSize="24" FontWeight="SemiBold" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,0" />
                    <TextBlock Text="选择模式与模型，开始你的第一个任务" FontSize="12.5" TextAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,7,0,0" />
                </StackPanel>

                <!-- 输入卡 -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1" CornerRadius="14" Padding="14,12" x:Name="InputCard">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 输入框 -->
                        <Grid Grid.Row="0">
                            <TextBox x:Name="InputBox" Style="{x:Null}"
                                     Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource AccentBrush}" TextWrapping="Wrap" AcceptsReturn="True"
                                     MaxLength="8000" VerticalScrollBarVisibility="Auto" FontSize="14"
                                     MinHeight="52" MaxHeight="160" VerticalContentAlignment="Top" Padding="0"
                                     KeyDown="InputBox_KeyDown" />
                            <TextBlock Text="给 Harness 发送消息…" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14"
                                       VerticalAlignment="Top" Margin="1,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- 模式 / 模型 / 发送 -->
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="模式" Style="{StaticResource SectionLabel}"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ListBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding SelectedMode}"
                                     ItemContainerStyle="{StaticResource ChipListItem}"
                                     Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <ComboBox Grid.Column="2" Style="{StaticResource FieldComboBox}"
                                      ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                                      DisplayMemberPath="Name" MinWidth="170" MaxWidth="240"
                                      Margin="8,0,0,0" VerticalAlignment="Center"
                                      ToolTip="选择模型服务" />
                            <Button Grid.Column="4" Style="{StaticResource RoundAccentButton}" Margin="10,0,0,0" />
                        </Grid>
                    </Grid>
                </Border>
                <TextBlock Text="Enter 发送 · Shift+Enter 换行" FontSize="10.5" TextAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,8,0,0" />

                <!-- 建议卡 -->
                <TextBlock Text="试试这些" Style="{StaticResource SectionLabel}" Margin="5,18,0,8" />
                <UniformGrid Columns="2" Margin="-5,0">
                    <Button Style="{StaticResource SuggestionCard}" Command="{Binding QuickPromptCommand}" Margin="5,0,5,10"
                            CommandParameter="帮我把这周的工作整理成一份周报，重点标注进展和风险">
                        <StackPanel>
                            <TextBlock Text="🕐 周报总结" Style="{StaticResource SuggestionCardTitle}" />
                            <TextBlock Text="整理本周进展与风险" Style="{StaticResource SuggestionCardDesc}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SuggestionCard}" Command="{Binding QuickPromptCommand}" Margin="5,0,5,10"
                            CommandParameter="这个报错是什么原因，该怎么修：NullReferenceException at Main()">
                        <StackPanel>
                            <TextBlock Text="⚠️ 报错修复" Style="{StaticResource SuggestionCardTitle}" />
                            <TextBlock Text="粘贴报错信息速查原因" Style="{StaticResource SuggestionCardDesc}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SuggestionCard}" Command="{Binding QuickPromptCommand}" Margin="5,0,5,0"
                            CommandParameter="帮我列一个技术方案分享 PPT 的大纲，20 页以内">
                        <StackPanel>
                            <TextBlock Text="🖥 PPT 制作" Style="{StaticResource SuggestionCardTitle}" />
                            <TextBlock Text="生成分享大纲与要点" Style="{StaticResource SuggestionCardDesc}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SuggestionCard}" Command="{Binding QuickPromptCommand}" Margin="5,0,5,0"
                            CommandParameter="现在几点了？">
                        <StackPanel>
                            <TextBlock Text="🛠 试试工具" Style="{StaticResource SuggestionCardTitle}" />
                            <TextBlock Text="ReAct 模式调用工具演示" Style="{StaticResource SuggestionCardDesc}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
